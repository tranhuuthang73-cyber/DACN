generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String?
  email         String   @unique
  password_hash String
  role          String   @default("FARMER")
  created_at    DateTime @default(now())

  plots         Plot[]

  @@map("users")
}

model Plot {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String
  area_m2    Float
  soil_type  String?
  latitude   Float?
  longitude  Float?
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  seasons    Season[]
  logs       FarmingLog[]
  recommendations Recommendation[]
  model_updates ModelUpdate[]

  @@map("plots")
}

model Season {
  id                    Int          @id @default(autoincrement())
  plot_id               Int
  crop_type             String
  planted_date          DateTime
  expected_harvest_date DateTime?
  target_yield          Float?
  actual_yield          Float?
  actual_harvest_date   DateTime?
  quality               String?      // A | B | C
  status                String       @default("PLANNING")
  unit_price_vnd        Float        @default(0)
  revenue_vnd           Float        @default(0)
  created_at            DateTime     @default(now())

  plot                  Plot         @relation(fields: [plot_id], references: [id], onDelete: Cascade)
  logs                  FarmingLog[]
  recommendations       Recommendation[]

  @@map("seasons")
}

model FarmingLog {
  id         Int      @id @default(autoincrement())
  season_id  Int
  plot_id    Int
  type       String   // WATER | FERTILIZER | OTHER
  amount     Float
  unit       String
  method     String?
  note       String?
  cost_vnd   Float    @default(0)
  logged_at  DateTime @default(now())
  created_at DateTime @default(now())

  season     Season   @relation(fields: [season_id], references: [id], onDelete: Cascade)
  plot       Plot     @relation(fields: [plot_id], references: [id], onDelete: NoAction)

  @@map("farming_logs")
}

model Recommendation {
  id               Int                @id @default(autoincrement())
  season_id        Int
  plot_id          Int
  type             String             // WATER | FERTILIZER
  suggested_amount Float
  suggested_time   DateTime?
  confidence_score Float?
  reason           String?            // Explainable AI reason (SRS Section 6)
  model_version    Int
  created_at       DateTime           @default(now())

  season           Season             @relation(fields: [season_id], references: [id], onDelete: Cascade)
  plot             Plot               @relation(fields: [plot_id], references: [id], onDelete: NoAction)
  feedbacks        RecommendationFeedback[]

  @@map("recommendations")
}

model RecommendationFeedback {
  id                Int            @id @default(autoincrement())
  recommendation_id Int
  action            String         // ACCEPTED | REJECTED | MODIFIED
  actual_value      Float?
  responded_at      DateTime       @default(now())

  recommendation    Recommendation @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)

  @@map("recommendation_feedback")
}

model ModelUpdate {
  id            Int                @id @default(autoincrement())
  plot_id       Int
  model_version Int
  trigger       String             // ON_FEEDBACK | ON_HARVEST
  updated_at    DateTime           @default(now())

  plot          Plot               @relation(fields: [plot_id], references: [id], onDelete: Cascade)

  @@map("model_updates")
}
