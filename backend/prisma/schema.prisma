generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  ADMIN
}

enum SeasonStatus {
  PLANNING
  GROWING
  HARVESTED
}

enum LogType {
  WATER
  FERTILIZER
  OTHER
}

enum RecommendationType {
  WATER
  FERTILIZER
}

enum FeedbackAction {
  ACCEPTED
  REJECTED
  MODIFIED
}

enum ModelUpdateTrigger {
  ON_FEEDBACK
  ON_HARVEST
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String?
  email         String   @unique
  password_hash String
  role          Role     @default(FARMER)
  created_at    DateTime @default(now())

  plots         Plot[]

  @@map("users")
}

model Plot {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String
  area_m2    Float
  soil_type  String?
  latitude   Float?
  longitude  Float?
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  seasons    Season[]
  logs       FarmingLog[]
  recommendations Recommendation[]
  model_updates ModelUpdate[]

  @@map("plots")
}

model Season {
  id                    Int          @id @default(autoincrement())
  plot_id               Int
  crop_type             String
  planted_date          DateTime
  expected_harvest_date DateTime?
  target_yield          Float?
  actual_yield          Float?
  actual_harvest_date   DateTime?
  status                SeasonStatus @default(PLANNING)
  created_at            DateTime     @default(now())

  plot                  Plot         @relation(fields: [plot_id], references: [id])
  logs                  FarmingLog[]
  recommendations       Recommendation[]

  @@map("seasons")
}

model FarmingLog {
  id         Int      @id @default(autoincrement())
  season_id  Int
  plot_id    Int
  type       LogType
  amount     Float
  unit       String
  method     String?
  note       String?
  logged_at  DateTime @default(now())
  created_at DateTime @default(now())

  season     Season   @relation(fields: [season_id], references: [id])
  plot       Plot     @relation(fields: [plot_id], references: [id])

  @@map("farming_logs")
}

model Recommendation {
  id               Int                @id @default(autoincrement())
  season_id        Int
  plot_id          Int
  type             RecommendationType
  suggested_amount Float
  suggested_time   DateTime?
  confidence_score Float?
  model_version    Int
  created_at       DateTime           @default(now())

  season           Season             @relation(fields: [season_id], references: [id])
  plot             Plot               @relation(fields: [plot_id], references: [id])
  feedbacks        RecommendationFeedback[]

  @@map("recommendations")
}

model RecommendationFeedback {
  id                Int            @id @default(autoincrement())
  recommendation_id Int
  action            FeedbackAction
  actual_value      Float?
  responded_at      DateTime       @default(now())

  recommendation    Recommendation @relation(fields: [recommendation_id], references: [id])

  @@map("recommendation_feedback")
}

model ModelUpdate {
  id            Int                @id @default(autoincrement())
  plot_id       Int
  model_version Int
  trigger       ModelUpdateTrigger
  updated_at    DateTime           @default(now())

  plot          Plot               @relation(fields: [plot_id], references: [id])

  @@map("model_updates")
}
