<?php
/**
 * TravelGo - Environment Configuration
 * Copy file này thành .env và điền thông tin thật
 */

// Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelgo
DB_USER=root
DB_PASS=

// App
APP_NAME=TravelGo
APP_URL=http://localhost/DULICH/public
APP_ENV=development
APP_DEBUG=true
APP_KEY=travelgo_secret_key_change_this

// Session
SESSION_LIFETIME=120
SESSION_NAME=travelgo_session

// Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@travelgo.vn
MAIL_FROM_NAME=TravelGo

// VNPay Sandbox
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost/DULICH/public/payment/vnpay-return

// MoMo Sandbox
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost/DULICH/public/payment/momo-return
MOMO_NOTIFY_URL=http://localhost/DULICH/public/payment/momo-notify
