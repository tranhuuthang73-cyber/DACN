<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nếu truy cập thư mục gốc (vd: http://localhost/DACN/ hoặc http://localhost/DULICH/)
    # Chuyển hướng hoặc rewrite thẳng vào thư mục public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>
